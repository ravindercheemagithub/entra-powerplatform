        <mxCell id="c41" value="&lt;b&gt;Two modes&lt;/b&gt; (EntraSettings.ChangeMode).&lt;br&gt;&lt;b&gt;gated&lt;/b&gt;: ER-02 waits for CAB and the change window (change reaches Implement).&lt;br&gt;&lt;b&gt;record&lt;/b&gt;: the in-app approvals are enough; the change is raised, ER-02 runs at once, and the change is closed for the audit trail." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#D9B300;fontSize=11;align=left;verticalAlign=top;spacing=6;fontColor=#323130;size=14;" vertex="1" parent="1">
          <mxGeometry x="1090" y="780" width="590" height="100" as="geometry"/>
        </mxCell>
