          <mxGeometry x="320" y="660" width="240" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="c33" value="ER-01 makes the item read-only, then copies PayloadJson into ApprovedPayloadJson." style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="320" y="686" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="c34" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/identity/Users.svg;labelBackgroundColor=none;verticalLabelPosition=bottom;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="672" y="590" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c35" value="&lt;b style='font-size:12px'&gt;&amp;#9314; Two approvals&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="580" y="660" width="240" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="c36" value="Manager, then Entra ID team. A responder equal to the requester counts as Reject." style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="580" y="686" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="c37" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/power_platform/PowerAutomate.svg;labelBackgroundColor=none;verticalLabelPosition=bottom;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="932" y="590" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c38" value="&lt;b style='font-size:12px'&gt;&amp;#9315; Editor check&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="840" y="660" width="240" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="c39" value="ER-02 runs only if the last editor is the flow account and both decisions are Approved." style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="840" y="686" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="c40" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/identity/Groups.svg;labelBackgroundColor=none;verticalLabelPosition=bottom;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="1192" y="590" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c41" value="&lt;b style='font-size:12px'&gt;&amp;#9316; Ownership&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="1100" y="660" width="240" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="c42" value="Changes to an existing app need team membership or ownership, and a matching appCatID." style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="1100" y="686" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="c43" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/identity/Azure_Active_Directory.svg;labelBackgroundColor=none;verticalLabelPosition=bottom;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="1452" y="590" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c44" value="&lt;b style='font-size:12px'&gt;&amp;#9317; Stamping&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="1360" y="660" width="240" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="c45" value="Every object carries appCatID, requestId, createdBy, managedBy for audit and sync." style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="1360" y="686" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e46" value="" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=10;fontColor=#323130;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;strokeWidth=2;endArrow=blockThin;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="220" y="618" as="sourcePoint"/>
            <mxPoint x="400" y="618" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e47" value="" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=10;fontColor=#323130;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;strokeWidth=2;endArrow=blockThin;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="618" as="sourcePoint"/>
            <mxPoint x="660" y="618" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e48" value="" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=10;fontColor=#323130;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;strokeWidth=2;endArrow=blockThin;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="740" y="618" as="sourcePoint"/>
            <mxPoint x="920" y="618" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e49" value="" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=10;fontColor=#323130;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;strokeWidth=2;endArrow=blockThin;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1000" y="618" as="sourcePoint"/>
            <mxPoint x="1180" y="618" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e50" value="" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=10;fontColor=#323130;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;strokeWidth=2;endArrow=blockThin;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1260" y="618" as="sourcePoint"/>
            <mxPoint x="1440" y="618" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c51" value="&lt;b&gt;The one real risk.&lt;/b&gt; Whoever can edit ER-02 or ER-03 can make any Graph call the platform app is allowed to make. Treat flow co-ownership like an Entra admin role." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#D9B300;fontSize=11;align=left;verticalAlign=top;spacing=6;fontColor=#323130;size=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="810" width="560" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="c52" value="&lt;b&gt;Rotate the certificate yearly.&lt;/b&gt; Upload the new one to the app registration, update the connection, then remove the old one. If other automations share the app, give this solution its own certificate." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#D9B300;fontSize=11;align=left;verticalAlign=top;spacing=6;fontColor=#323130;size=14;" vertex="1" parent="1">
          <mxGeometry x="630" y="810" width="620" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="c53" value="&lt;b&gt;Audit:&lt;/b&gt; EntraRequests versions, flow run history, Entra audit log (initiated by the platform app)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#D9B300;fontSize=11;align=left;verticalAlign=top;spacing=6;fontColor=#323130;size=14;" vertex="1" parent="1">
          <mxGeometry x="1280" y="810" width="380" height="70" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="12-deployment-and-build-order" name="12 Deployment and build order">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="&lt;b style='font-size:16px'&gt;Deployment &amp;mdash; what exists, and the order to build it&lt;/b&gt;&lt;br&gt;Three places to configure: Entra ID, the SharePoint site, and the Power Platform environment." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#605E5C;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="Microsoft Entra ID tenant" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1ECF7;strokeColor=#5C2D91;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#323130;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="520" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Platform app registration&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;18723-Q-M365-&lt;br&gt;Automation-AppProvisioning&lt;br&gt;certificate &amp;middot; 5 Graph permissions&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/identity/App_Registrations.svg;labelBackgroundColor=none;verticalLabelPosition=bottom;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="160" y="160" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Flow account&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;member user&lt;br&gt;M365 + Power Automate Premium&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/identity/Users.svg;labelBackgroundColor=none;verticalLabelPosition=bottom;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="160" y="340" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;Requesters&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Manager attribute set&lt;br&gt;(for Get manager)&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/identity/Users.svg;labelBackgroundColor=none;verticalLabelPosition=bottom;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="160" y="500" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;Copy for later&lt;/b&gt;&lt;br&gt;&lt;font style='font-family:monospace;font-size:10px'&gt;Directory (tenant) ID&lt;br&gt;Application (client) ID&lt;br&gt;.pfx + password&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="330" y="160" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;Check in Entra&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;API permissions: 'Granted for &amp;lt;tenant&amp;gt;'&lt;br&gt;Certificates: your thumbprint&lt;br&gt;Conditional Access: no sign-in frequency on the flow account&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="330" y="330" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="c8" value="SharePoint site /teams/m365automationqa" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2FAFA;strokeColor=#03787C;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#323130;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="590" y="100" width="500" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="c9" value="&lt;b&gt;EntraRequests&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;item-level security &amp;middot; versioning 500&lt;/font&gt;" style="sketch=0;pointerEvents=1;shadow=0;dashed=0;html=1;strokeColor=none;fillColor=#03787C;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;outlineConnect=0;align=center;shape=mxgraph.office.concepts.list_library;fontSize=10;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="670" y="160" width="50" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;EntraCatalogApps&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;members Read&lt;/font&gt;" style="sketch=0;pointerEvents=1;shadow=0;dashed=0;html=1;strokeColor=none;fillColor=#03787C;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;outlineConnect=0;align=center;shape=mxgraph.office.concepts.list_library;fontSize=10;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="670" y="280" width="50" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c11" value="&lt;b&gt;EntraCatalogGroups&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;members Read&lt;/font&gt;" style="sketch=0;pointerEvents=1;shadow=0;dashed=0;html=1;strokeColor=none;fillColor=#03787C;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;outlineConnect=0;align=center;shape=mxgraph.office.concepts.list_library;fontSize=10;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="670" y="400" width="50" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;EntraSettings&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;owners only &amp;middot; item ID 1&lt;/font&gt;" style="sketch=0;pointerEvents=1;shadow=0;dashed=0;html=1;strokeColor=none;fillColor=#03787C;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;outlineConnect=0;align=center;shape=mxgraph.office.concepts.list_library;fontSize=10;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="670" y="520" width="50" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="c13" value="&lt;b&gt;sharepoint/provision.ps1&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;creates all 4 lists, columns, indexes, permissions and the settings item (PnP PowerShell)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#03787C;strokeWidth=1.5;fontSize=12;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="840" y="160" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;Site groups&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Owners: Entra ID team + flow account&lt;br&gt;Members: requesters&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#03787C;strokeWidth=1.5;fontSize=12;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="840" y="300" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="c15" value="Power Platform environment &amp;middot; Entra Self-Service (solution)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#323130;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="1120" y="100" width="540" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="c16" value="&lt;b&gt;Entra Self-Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;paste 5 pa.yaml screens&lt;br&gt;publish &amp;middot; share as User&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/power_platform/PowerApps.svg;labelBackgroundColor=none;verticalLabelPosition=bottom;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="1220" y="160" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c17" value="&lt;b&gt;ER-01 &amp;middot; ER-02 &amp;middot; ER-03&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;built from docs/04&lt;br&gt;owner = flow account&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/power_platform/PowerAutomate.svg;labelBackgroundColor=none;verticalLabelPosition=bottom;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="1220" y="330" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c18" value="&lt;b&gt;Dataverse&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;required by Approvals&lt;/font&gt;" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/power_platform/Dataverse.svg;labelBackgroundColor=none;verticalLabelPosition=bottom;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="1220" y="490" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c19" value="Connections (flow account)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#323130;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1380" y="160" width="260" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="c20" value="SharePoint &amp;middot; Office 365 Users" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;overflow=hidden;whiteSpace=wrap;html=1;fontSize=10;fontColor=#323130;" vertex="1" parent="c19">
          <mxGeometry x="0" y="30" width="260" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="c21" value="Approvals &amp;middot; Office 365 Outlook" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;overflow=hidden;whiteSpace=wrap;html=1;fontSize=10;fontColor=#323130;" vertex="1" parent="c19">
          <mxGeometry x="0" y="52" width="260" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="c22" value="Microsoft Teams (optional)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;overflow=hidden;whiteSpace=wrap;html=1;fontSize=10;fontColor=#323130;" vertex="1" parent="c19">
          <mxGeometry x="0" y="74" width="260" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="c23" value="&lt;b&gt;HTTP with Entra ID&lt;/b&gt;: client certificate" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;overflow=hidden;whiteSpace=wrap;html=1;fontSize=10;fontColor=#323130;" vertex="1" parent="c19">
          <mxGeometry x="0" y="96" width="260" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="c24" value="&lt;b&gt;Licences&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Users: Microsoft 365 (Standard connectors)&lt;br&gt;Flow account: Power Automate Premium&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="1380" y="330" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="c25" value="&lt;b&gt;Build order&lt;/b&gt;&lt;br&gt;&amp;#9312; &lt;b&gt;Entra admin&lt;/b&gt;: app registration, upload the .crt, add 5 permissions, grant admin consent (docs/01)&lt;br&gt;&amp;#9313; &lt;b&gt;Site owner&lt;/b&gt;: run provision.ps1, or create the lists by hand (docs/02)&lt;br&gt;&amp;#9314; Fill the EntraSettings item: tenant, client ID, ServiceAccountUpn, approvers, fallback&lt;br&gt;&amp;#9315; &lt;b&gt;Power Apps&lt;/b&gt;: add data sources, paste formulas and screens, publish (docs/03)&lt;br&gt;&amp;#9316; &lt;b&gt;Power Automate&lt;/b&gt;, as the flow account: create connections, build ER-01, ER-02, ER-03 (docs/04)&lt;br&gt;&amp;#9317; Copy the app's web link into EntraSettings.PowerAppUrl&lt;br&gt;&amp;#9318; Test: one request per type, plus a rejection and a self-approval (docs/05)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#D9B300;fontSize=11;align=left;verticalAlign=top;spacing=6;fontColor=#323130;size=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="820" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="c26" value="&lt;b&gt;Test the Graph connection first.&lt;/b&gt; In a scratch flow: Invoke an HTTP request &lt;code&gt;GET /v1.0/organization&lt;/code&gt;. A 403 means consent is missing; AADSTS700027 means the certificate doesn't match." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#D9B300;fontSize=11;align=left;verticalAlign=top;spacing=6;fontColor=#323130;size=14;" vertex="1" parent="1">
          <mxGeometry x="900" y="690" width="560" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="c27" value="&lt;b&gt;Move to production&lt;/b&gt; by exporting the solution; connections are re-created in the target environment." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#D9B300;fontSize=11;align=left;verticalAlign=top;spacing=6;fontColor=#323130;size=14;" vertex="1" parent="1">
          <mxGeometry x="900" y="790" width="560" height="60" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="13-option---graph-connection" name="13 Option - Graph connection">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="&lt;b style='font-size:16px'&gt;Option &amp;mdash; how ER-02 / ER-03 authenticate to Graph&lt;/b&gt;&lt;br&gt;Both use the same app registration and certificate. They differ in where the certificate lives." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#605E5C;spacing=2;" vertex="1" parent="1">
