  <diagram id="9-request-lifecycle" name="9 Request lifecycle">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="&lt;b style='font-size:16px'&gt;Request lifecycle &amp;mdash; EntraRequests.Status&lt;/b&gt;&lt;br&gt;Transitions name who makes them. Only the flow account moves a request past Submitted." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#605E5C;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="" style="ellipse;fillColor=#323130;strokeColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="40" y="228" width="24" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="Submitted" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="110" y="210" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="PendingManager&lt;br&gt;Approval" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#C19C00;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="340" y="210" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="c5" value="PendingEntra&lt;br&gt;Approval" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#C19C00;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="590" y="210" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="c6" value="Approved" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#0078D4;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#323130;" vertex="1" parent="1">
