        <mxCell id="c14" value="Limit: 100 calls per minute per connection" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;overflow=hidden;whiteSpace=wrap;html=1;fontSize=10;fontColor=#323130;" vertex="1" parent="c7">
