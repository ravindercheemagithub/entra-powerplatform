        <mxCell id="c45" value="&lt;b&gt;Why the guard.&lt;/b&gt; A site owner editing Status by hand is not the flow account, so the run stops before any Graph call." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#D9B300;fontSize=11;align=left;verticalAlign=top;spacing=6;fontColor=#323130;size=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="c46" value="&lt;b&gt;Retries.&lt;/b&gt; Enterprise app creation retries until the new app has replicated; role assignment retries 4&amp;#215; with backoff." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#D9B300;fontSize=11;align=left;verticalAlign=top;spacing=6;fontColor=#323130;size=14;" vertex="1" parent="1">
          <mxGeometry x="1200" y="620" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="c47" value="&lt;b&gt;Not idempotent.&lt;/b&gt; Re-running a failed createAppRegistration creates a second app; ResultJson lists what to clean up first." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#D9B300;fontSize=11;align=left;verticalAlign=top;spacing=6;fontColor=#323130;size=14;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1110" width="260" height="90" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="8-flow---er-03-catalog-sync" name="8 Flow - ER-03 Catalog sync">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1020" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="&lt;b style='font-size:16px'&gt;Flowchart &amp;mdash; ER-03 Catalog sync&lt;/b&gt;&lt;br&gt;Hourly. Reads Entra ID, writes the two catalog lists the app uses for its pickers. Never changes Entra." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#605E5C;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="Recurrence &amp;middot; every hour" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="450" y="90" width="220" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;GET /applications&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;$filter = tags/any(t: t eq 'managedBy:&amp;lt;tag&amp;gt;')&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="380" y="170" width="360" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="For each app" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#323130;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="350" y="260" width="420" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="c5" value="&lt;font style='font-size:10px'&gt;concurrency 1&lt;/font&gt;" style="text;html=1;align=right;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#605E5C;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="660" y="266" width="100" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="c6" value="team id from the &lt;b&gt;team:&lt;/b&gt; tag &amp;#8594; transitive members" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="380" y="300" width="360" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="c7" value="owners &amp;middot; enterprise app id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="380" y="370" width="360" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;Upsert EntraCatalogApps&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;roles, scopes, TeamMemberUpns, OwnerUpns&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="380" y="440" width="360" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c9" value="ensure the team has an EntraCatalogGroups row" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="380" y="520" width="360" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;Get all EntraCatalogGroups rows&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="380" y="620" width="360" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="c11" value="For each group" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fontColor=#323130;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="350" y="690" width="420" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="c12" value="&lt;font style='font-size:10px'&gt;concurrency 5&lt;/font&gt;" style="text;html=1;align=right;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#605E5C;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="660" y="696" width="100" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="c13" value="GET group &amp;middot; transitive members &amp;middot; owners" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="380" y="730" width="360" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;Update row&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;appCatID parsed from the description &amp;middot; Member/OwnerUpns&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="380" y="800" width="360" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="c15" value="" style="ellipse;fillColor=#323130;strokeColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="548.0" y="920" width="24" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#323130;strokeWidth=1.5;fontSize=10;fontColor=#323130;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#323130;strokeWidth=1.5;fontSize=10;fontColor=#323130;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#323130;strokeWidth=1.5;fontSize=10;fontColor=#323130;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#323130;strokeWidth=1.5;fontSize=10;fontColor=#323130;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#323130;strokeWidth=1.5;fontSize=10;fontColor=#323130;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c9">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#323130;strokeWidth=1.5;fontSize=10;fontColor=#323130;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c9" target="c10">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#323130;strokeWidth=1.5;fontSize=10;fontColor=#323130;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c10" target="c13">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#323130;strokeWidth=1.5;fontSize=10;fontColor=#323130;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c13" target="c14">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#323130;strokeWidth=1.5;fontSize=10;fontColor=#323130;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c15">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c25" value="&lt;b&gt;UPN lists format&lt;/b&gt;&lt;br&gt;&lt;font style='font-family:monospace;font-size:10px'&gt;;alex@contoso.com;sam@contoso.com;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;lower case, ';' at both ends, so the app can test &lt;i&gt;&quot;;&quot; &amp;amp; upn &amp;amp; &quot;;&quot; in TeamMemberUpns&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="820" y="300" width="400" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="c26" value="&lt;b&gt;Onboarding an existing group:&lt;/b&gt; add a row to EntraCatalogGroups with just Title and GroupId, then run ER-03 manually. It fills in members, owners and appCatID." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#D9B300;fontSize=11;align=left;verticalAlign=top;spacing=6;fontColor=#323130;size=14;" vertex="1" parent="1">
          <mxGeometry x="820" y="620" width="400" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="c27" value="&lt;b&gt;Deleted group?&lt;/b&gt; GET returns 404 and that iteration fails. Add a branch with run-after 'has failed' to flag or delete the row." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#D9B300;fontSize=11;align=left;verticalAlign=top;spacing=6;fontColor=#323130;size=14;" vertex="1" parent="1">
          <mxGeometry x="820" y="760" width="400" height="64" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
