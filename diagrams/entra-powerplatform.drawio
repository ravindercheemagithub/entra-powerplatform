        </mxCell>
        <mxCell id="c33" value="&lt;b&gt;Add existing group&lt;/b&gt;: the user types a name or Object ID &amp;#8594; Patch an onboardGroup item &amp;#8594; a Timer re-reads that item every 3 s (up to 60 s) &amp;#8594; shows &lt;i&gt;Added&lt;/i&gt;, or the ErrorMessage written by ER-04. The group then appears in the Owning team and role-group pickers." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="1085" width="1380" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="c34" value="&lt;b&gt;Why membership is required.&lt;/b&gt; Otherwise anyone could attach any group to their app's roles, or claim a team they're not in." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#D9B300;fontSize=11;align=left;verticalAlign=top;spacing=6;fontColor=#323130;size=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="300" height="80" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
