        <mxCell id="c4" value="B &amp;middot; in Key Vault, read by the flow" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontStyle=1;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="1100" y="200" width="320" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeColor=#107C10;strokeWidth=1.5;fontSize=10;fontColor=#323130;labelBackgroundColor=#FFFFFF;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="c2" target="c3">
          <mxGeometry relative="1" as="geometry">
