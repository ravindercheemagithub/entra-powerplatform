        <mxCell id="c30" value="&lt;font style='font-size:10px'&gt;Graph permissions (admin-consented): Application.ReadWrite.All &amp;middot; AppRoleAssignment.ReadWrite.All &amp;middot; Group.ReadWrite.All &amp;middot; Directory.Read.All &amp;middot; User.Read.All&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5C2D91;spacing=2;" vertex="1" parent="1">
