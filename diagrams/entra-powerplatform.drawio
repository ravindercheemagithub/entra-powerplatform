        </mxCell>
        <mxCell id="c53" value="&lt;b&gt;Anyone who can edit ER-02 or ER-03 can use that connection.&lt;/b&gt; Keep the flows in their own environment, with only the Entra ID team as co-owners." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#D9B300;fontSize=11;align=left;verticalAlign=top;spacing=6;fontColor=#323130;size=14;" vertex="1" parent="1">
