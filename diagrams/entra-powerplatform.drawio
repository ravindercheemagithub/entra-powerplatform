        </mxCell>
        <mxCell id="c31" value="&lt;b&gt;Don't pick 'Log in with Microsoft Entra ID'&lt;/b&gt; on the connection: that calls Graph as the flow account, and a read-only account gets &lt;i&gt;Insufficient privileges&lt;/i&gt;." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#D9B300;fontSize=11;align=left;verticalAlign=top;spacing=6;fontColor=#323130;size=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="885" width="620" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="c32" value="&lt;b&gt;The certificate stays inside the connection.&lt;/b&gt; Flow editors can use it but can't read it; run history never shows it." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#D9B300;fontSize=11;align=left;verticalAlign=top;spacing=6;fontColor=#323130;size=14;" vertex="1" parent="1">
          <mxGeometry x="690" y="885" width="520" height="60" as="geometry"/>
        </mxCell>
