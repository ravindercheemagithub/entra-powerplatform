<?xml version="1.0" ?>
<mxfile host="app.diagrams.net" type="device" version="24.7.0">
  <diagram id="1-at-a-glance" name="1 At a glance">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="&lt;b style='font-size:16px'&gt;Entra self-service on Power Platform &amp;mdash; at a glance&lt;/b&gt;&lt;br&gt;A team asks for an app registration in a Power App; two people approve; a flow creates it in Entra ID." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#605E5C;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="STEP 1" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#0078D4;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="130" y="110" width="80" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/power_platform/PowerApps.svg;labelBackgroundColor=none;verticalLabelPosition=bottom;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="134" y="140" width="72" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="&lt;b style='font-size:14px'&gt;Ask&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#323130;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="226" width="220" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="c5" value="The requester fills in a wizard: appCatID, environment, BoR short name + name, an existing owning team, roles." style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="55" y="254" width="230" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="c6" value="STEP 2" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#0078D4;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="390" y="110" width="80" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="c7" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/power_platform/PowerAutomate.svg;labelBackgroundColor=none;verticalLabelPosition=bottom;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="394" y="140" width="72" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="c8" value="&lt;b style='font-size:14px'&gt;Lock&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#323130;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="320" y="226" width="220" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="c9" value="Flow ER-01 makes the request read-only, so what gets approved can't change afterwards." style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="315" y="254" width="230" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="c10" value="STEP 3" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#0078D4;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="650" y="110" width="80" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="c11" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/identity/Users.svg;labelBackgroundColor=none;verticalLabelPosition=bottom;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="654" y="140" width="72" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="c12" value="&lt;b style='font-size:14px'&gt;Approve&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#323130;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="580" y="226" width="220" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="c13" value="The requester's manager approves, then the Entra ID team. A self-approval counts as a rejection." style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="575" y="254" width="230" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="c14" value="STEP 4" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#0078D4;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="910" y="110" width="80" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="c15" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/power_platform/PowerAutomate.svg;labelBackgroundColor=none;verticalLabelPosition=bottom;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="914" y="140" width="72" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="c16" value="&lt;b style='font-size:14px'&gt;Create&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#323130;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="840" y="226" width="220" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="c17" value="Flow ER-02 calls Microsoft Graph as the platform app and creates everything that was approved." style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="835" y="254" width="230" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="c18" value="STEP 5" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#0078D4;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="1170" y="110" width="80" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="c19" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;image=img/lib/azure2/identity/Azure_Active_Directory.svg;labelBackgroundColor=none;verticalLabelPosition=bottom;verticalAlign=top;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="1174" y="140" width="72" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="c20" value="&lt;b style='font-size:14px'&gt;Stamp&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#323130;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="1100" y="226" width="220" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="c21" value="Every app and enterprise app carries the appCatID, environment, request ID and owning team." style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#323130;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="1095" y="254" width="230" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e22" value="" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=10;fontColor=#323130;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;strokeWidth=2;endArrow=blockThin;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="216" y="176" as="sourcePoint"/>
            <mxPoint x="384" y="176" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e23" value="" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=10;fontColor=#323130;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;strokeWidth=2;endArrow=blockThin;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="476" y="176" as="sourcePoint"/>
            <mxPoint x="644" y="176" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e24" value="" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=10;fontColor=#323130;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;strokeWidth=2;endArrow=blockThin;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="736" y="176" as="sourcePoint"/>
            <mxPoint x="904" y="176" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e25" value="" style="html=1;endArrow=blockThin;endFill=1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=10;fontColor=#323130;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;strokeWidth=2;endArrow=blockThin;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="996" y="176" as="sourcePoint"/>
            <mxPoint x="1164" y="176" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c26" value="&lt;b&gt;Where things live&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Power Apps canvas app &amp;middot; SharePoint site /teams/m365automationqa (4 lists) &amp;middot; 4 Power Automate flows &amp;middot; 1 Entra app registration with a certificate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="600" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="c27" value="&lt;b&gt;Licences&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;App and ER-01 use Standard connectors (covered by Microsoft 365). ER-02, ER-03 and ER-04 use a Premium connector: one Power Automate Premium licence for the flow owner.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="700" y="380" width="640" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="c28" value="&lt;b&gt;Nobody gets Entra admin rights.&lt;/b&gt; Requesters, managers and even the flow owner can be read-only in Entra. Only the platform app registration holds Graph permissions, and only the flows can use it." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#D9B300;fontSize=11;align=left;verticalAlign=top;spacing=6;fontColor=#323130;size=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="600" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="c29" value="&lt;b&gt;Two approvals, one snapshot.&lt;/b&gt; Approvers see a summary of the locked snapshot (ApprovedPayloadJson), and ER-02 executes only that snapshot, never the editable copy." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#D9B300;fontSize=11;align=left;verticalAlign=top;spacing=6;fontColor=#323130;size=14;" vertex="1" parent="1">
          <mxGeometry x="700" y="470" width="640" height="70" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="2-components" name="2 Components">
