        <mxCell id="c29" value="&lt;b&gt;Connection fields&lt;/b&gt;&lt;br&gt;&lt;font style='font-family:monospace;font-size:10px'&gt;Auth type: Log in using a Client Certificate Auth&lt;br&gt;Resource URI: https://graph.microsoft.com&lt;br&gt;Base Resource URL: https://graph.microsoft.com&lt;br&gt;Tenant: &amp;lt;Directory (tenant) ID&amp;gt;&lt;br&gt;Client ID: &amp;lt;appId of the platform app&amp;gt;&lt;br&gt;Client certificate: .pfx + password&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#323130;" vertex="1" parent="1">
          <mxGeometry x="1160" y="600" width="380" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="c30" value="&lt;font style='font-size:10px'&gt;Graph permissions (admin-consented): Application.ReadWrite.All &amp;middot; AppRoleAssignment.ReadWrite.All &amp;middot; Directory.Read.All &amp;middot; User.Read.All &amp;middot; no group write: groups are created elsewhere&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#5C2D91;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="380" y="800" width="760" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="c31" value="&lt;b&gt;Don't pick 'Log in with Microsoft Entra ID'&lt;/b&gt; on the connection: that calls Graph as the flow account, and a read-only account gets &lt;i&gt;Insufficient privileges&lt;/i&gt;." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#D9B300;fontSize=11;align=left;verticalAlign=top;spacing=6;fontColor=#323130;size=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="885" width="620" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="c32" value="&lt;b&gt;The certificate stays inside the connection.&lt;/b&gt; Flow editors can use it but can't read it; run history never shows it." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#D9B300;fontSize=11;align=left;verticalAlign=top;spacing=6;fontColor=#323130;size=14;" vertex="1" parent="1">
          <mxGeometry x="690" y="885" width="520" height="60" as="geometry"/>
        </mxCell>
