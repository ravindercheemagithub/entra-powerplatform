{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "esp_sharedsharepointonline_entra"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365users": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "esp_sharedoffice365users_entra"
        },
        "api": {
          "name": "shared_office365users"
        }
      },
      "shared_approvals": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "esp_sharedapprovals_entra"
        },
        "api": {
          "name": "shared_approvals"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "esp_sharedoffice365_entra"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_webcontents": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "esp_sharedwebcontents_entra"
        },
        "api": {
          "name": "shared_webcontents"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "SharePoint site URL (esp_SiteUrl)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "esp_SiteUrl",
            "description": "SharePoint site that holds the Entra self-service lists"
          }
        }
      },
      "triggers": {
        "When_an_item_is_created": {
          "type": "OpenApiConnection",
          "recurrence": {
            "interval": 1,
            "frequency": "Minute"
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnNewItems"
            },
            "parameters": {
              "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
              "table": "EntraRequests"
            },
            "authentication": "@parameters('$authentication')"
          },
          "conditions": [
            {
              "expression": "@and(equals(triggerBody()?['Status']?['Value'], 'Submitted'), not(contains(createArray('onboardGroup', 'lookupApp', 'tagOwnerGroup'), triggerBody()?['RequestType']?['Value'])))"
            }
          ]
        }
      },
      "actions": {
        "Get_settings": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItem"
            },
            "parameters": {
              "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
              "table": "EntraSettings",
              "id": 1
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {}
        },
        "Ensure_requester": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            },
            "parameters": {
              "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
              "parameters/method": "POST",
              "parameters/uri": "_api/web/ensureuser",
              "parameters/headers": {
                "Accept": "application/json;odata=nometadata",
                "Content-Type": "application/json;odata=nometadata"
              },
              "parameters/body": "{\"logonName\": \"@{triggerOutputs()?['body/Author/Claims']}\"}"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Get_settings": [
              "Succeeded"
            ]
          }
        },
        "Get_owner_group": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            },
            "parameters": {
              "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
              "parameters/method": "GET",
              "parameters/uri": "_api/web/associatedownergroup?$select=Id",
              "parameters/headers": {
                "Accept": "application/json;odata=nometadata"
              }
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Ensure_requester": [
              "Succeeded"
            ]
          }
        },
        "Break_inheritance": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            },
            "parameters": {
              "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
              "parameters/method": "POST",
              "parameters/uri": "_api/web/lists/getbytitle('EntraRequests')/items(@{triggerOutputs()?['body/ID']})/breakroleinheritance(copyRoleAssignments=false,clearSubscopes=true)",
              "parameters/headers": {
                "Accept": "application/json;odata=nometadata"
              }
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Get_owner_group": [
              "Succeeded"
            ]
          }
        },
        "Grant_owners": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            },
            "parameters": {
              "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
              "parameters/method": "POST",
              "parameters/uri": "_api/web/lists/getbytitle('EntraRequests')/items(@{triggerOutputs()?['body/ID']})/roleassignments/addroleassignment(principalid=@{body('Get_owner_group')?['Id']},roledefid=1073741829)",
              "parameters/headers": {
                "Accept": "application/json;odata=nometadata"
              }
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Break_inheritance": [
              "Succeeded"
            ]
          }
        },
        "Grant_requester_read": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            },
            "parameters": {
              "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
              "parameters/method": "POST",
              "parameters/uri": "_api/web/lists/getbytitle('EntraRequests')/items(@{triggerOutputs()?['body/ID']})/roleassignments/addroleassignment(principalid=@{body('Ensure_requester')?['Id']},roledefid=1073741826)",
              "parameters/headers": {
                "Accept": "application/json;odata=nometadata"
              }
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Grant_owners": [
              "Succeeded"
            ]
          }
        },
        "Get_locked_item": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItem"
            },
            "parameters": {
              "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
              "table": "EntraRequests",
              "id": "@int(triggerOutputs()?['body/ID'])"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Grant_requester_read": [
              "Succeeded"
            ]
          }
        },
        "Payload": {
          "type": "Compose",
          "inputs": "@json(body('Get_locked_item')?['PayloadJson'])",
          "runAfter": {
            "Get_locked_item": [
              "Succeeded"
            ]
          }
        },
        "Init_varAccessGroup": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varAccessGroup",
                "type": "object",
                "value": {}
              }
            ]
          },
          "runAfter": {
            "Payload": [
              "Succeeded"
            ]
          }
        },
        "Init_varAccessMember": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varAccessMember",
                "type": "string",
                "value": ""
              }
            ]
          },
          "runAfter": {
            "Init_varAccessGroup": [
              "Succeeded"
            ]
          }
        },
        "Access_for_a_group": {
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@and(equals(triggerOutputs()?['body/RequestType/Value'], 'grantAccess'), equals(outputs('Payload')?['principalType'], 'group'))",
                  true
                ]
              }
            ]
          },
          "actions": {
            "HTTP_Access_requester": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents",
                  "connectionName": "shared_webcontents",
                  "operationId": "InvokeHttp"
                },
                "parameters": {
                  "request/method": "GET",
                  "request/url": "https://graph.microsoft.com/v1.0/users/@{last(split(triggerOutputs()?['body/Author/Claims'], '|'))}?$select=id"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Access_group_query": {
              "type": "Compose",
              "inputs": "@trim(coalesce(outputs('Payload')?['groupQuery'], ''))",
              "runAfter": {
                "HTTP_Access_requester": [
                  "Succeeded"
                ]
              }
            },
            "Access_query_is_object_id": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@and(equals(length(outputs('Access_group_query')), 36), equals(length(split(outputs('Access_group_query'), '-')), 5))",
                      true
                    ]
                  }
                ]
              },
              "actions": {
                "HTTP_Access_group_by_id": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents",
                      "connectionName": "shared_webcontents",
                      "operationId": "InvokeHttp"
                    },
                    "parameters": {
                      "request/method": "GET",
                      "request/url": "https://graph.microsoft.com/v1.0/groups/@{toLower(outputs('Access_group_query'))}?$select=id,displayName,securityEnabled"
                    },
                    "authentication": "@parameters('$authentication')",
                    "retryPolicy": {
                      "type": "none"
                    }
                  },
                  "runAfter": {}
                },
                "Access_group_found_by_id": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@outputs('HTTP_Access_group_by_id')?['statusCode']",
                          200
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Set_access_group_from_id": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "varAccessGroup",
                        "value": "@body('HTTP_Access_group_by_id')"
                      },
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {
                      "Fail_access_group_id": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                            "connectionName": "shared_sharepointonline",
                            "operationId": "PatchItem"
                          },
                          "parameters": {
                            "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
                            "table": "EntraRequests",
                            "id": "@int(triggerOutputs()?['body/ID'])",
                            "item/Title": "@triggerOutputs()?['body/Title']",
                            "item/Status/Value": "Failed",
                            "item/ErrorMessage": "@concat('No group has the Object ID ', outputs('Access_group_query'), '.')"
                          },
                          "authentication": "@parameters('$authentication')"
                        },
                        "runAfter": {}
                      },
                      "Stop_access_group_id": {
                        "type": "Terminate",
                        "inputs": {
                          "runStatus": "Failed",
                          "runError": {
                            "code": "GroupNotFound",
                            "message": "@concat('No group has the Object ID ', outputs('Access_group_query'), '.')"
                          }
                        },
                        "runAfter": {
                          "Fail_access_group_id": [
                            "Succeeded"
                          ]
                        }
                      }
                    }
                  },
                  "runAfter": {
                    "HTTP_Access_group_by_id": [
                      "Succeeded",
                      "Failed"
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "HTTP_Access_group_by_name": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents",
                        "connectionName": "shared_webcontents",
                        "operationId": "InvokeHttp"
                      },
                      "parameters": {
                        "request/method": "GET",
                        "request/url": "https://graph.microsoft.com/v1.0/groups?$filter=displayName eq '@{encodeUriComponent(replace(outputs('Access_group_query'), '''', ''''''))}'&$select=id,displayName,securityEnabled&$top=5"
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runAfter": {}
                  },
                  "Access_group_name_unique": {
                    "type": "If",
                    "expression": {
                      "and": [
                        {
                          "equals": [
                            "@length(body('HTTP_Access_group_by_name')?['value'])",
                            1
                          ]
                        }
                      ]
                    },
                    "actions": {
                      "Set_access_group_from_name": {
                        "type": "SetVariable",
                        "inputs": {
                          "name": "varAccessGroup",
                          "value": "@first(body('HTTP_Access_group_by_name')?['value'])"
                        },
                        "runAfter": {}
                      }
                    },
                    "else": {
                      "actions": {
                        "Fail_access_group_name": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                              "connectionName": "shared_sharepointonline",
                              "operationId": "PatchItem"
                            },
                            "parameters": {
                              "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
                              "table": "EntraRequests",
                              "id": "@int(triggerOutputs()?['body/ID'])",
                              "item/Title": "@triggerOutputs()?['body/Title']",
                              "item/Status/Value": "Failed",
                              "item/ErrorMessage": "@if(empty(body('HTTP_Access_group_by_name')?['value']), concat('No group named ', outputs('Access_group_query'), ' was found.'), concat(string(length(body('HTTP_Access_group_by_name')?['value'])), ' groups are named ', outputs('Access_group_query'), '; use the Object ID.'))"
                            },
                            "authentication": "@parameters('$authentication')"
                          },
                          "runAfter": {}
                        },
                        "Stop_access_group_name": {
                          "type": "Terminate",
                          "inputs": {
                            "runStatus": "Failed",
                            "runError": {
                              "code": "GroupNotFound",
                              "message": "@if(empty(body('HTTP_Access_group_by_name')?['value']), concat('No group named ', outputs('Access_group_query'), ' was found.'), concat(string(length(body('HTTP_Access_group_by_name')?['value'])), ' groups are named ', outputs('Access_group_query'), '; use the Object ID.'))"
                            }
                          },
                          "runAfter": {
                            "Fail_access_group_name": [
                              "Succeeded"
                            ]
                          }
                        }
                      }
                    },
                    "runAfter": {
                      "HTTP_Access_group_by_name": [
                        "Succeeded"
                      ]
                    }
                  }
                }
              },
              "runAfter": {
                "Access_group_query": [
                  "Succeeded"
                ]
              }
            },
            "Access_group_is_security": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@variables('varAccessGroup')?['securityEnabled']",
                      true
                    ]
                  }
                ]
              },
              "actions": {},
              "else": {
                "actions": {
                  "Fail_access_not_security": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                        "connectionName": "shared_sharepointonline",
                        "operationId": "PatchItem"
                      },
                      "parameters": {
                        "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
                        "table": "EntraRequests",
                        "id": "@int(triggerOutputs()?['body/ID'])",
                        "item/Title": "@triggerOutputs()?['body/Title']",
                        "item/Status/Value": "Failed",
                        "item/ErrorMessage": "@concat(variables('varAccessGroup')?['displayName'], ' is not a security group; only security groups can be given access to an app.')"
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runAfter": {}
                  },
                  "Stop_access_not_security": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Failed",
                      "runError": {
                        "code": "NotSecurityGroup",
                        "message": "@concat(variables('varAccessGroup')?['displayName'], ' is not a security group; only security groups can be given access to an app.')"
                      }
                    },
                    "runAfter": {
                      "Fail_access_not_security": [
                        "Succeeded"
                      ]
                    }
                  }
                }
              },
              "runAfter": {
                "Access_query_is_object_id": [
                  "Succeeded"
                ]
              }
            },
            "HTTP_Access_membership": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents",
                  "connectionName": "shared_webcontents",
                  "operationId": "InvokeHttp"
                },
                "parameters": {
                  "request/method": "POST",
                  "request/url": "https://graph.microsoft.com/v1.0/users/@{body('HTTP_Access_requester')?['id']}/checkMemberGroups",
                  "request/headers": {
                    "Content-Type": "application/json"
                  },
                  "request/body": "{\"groupIds\": [\"@{variables('varAccessGroup')?['id']}\"]}"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Access_group_is_security": [
                  "Succeeded"
                ]
              }
            },
            "Set_access_member": {
              "type": "SetVariable",
              "inputs": {
                "name": "varAccessMember",
                "value": "@if(empty(body('HTTP_Access_membership')?['value']), 'no', 'yes')"
              },
              "runAfter": {
                "HTTP_Access_membership": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Init_varAccessMember": [
              "Succeeded"
            ]
          }
        },
        "Approved_payload": {
          "type": "Compose",
          "inputs": "@if(empty(variables('varAccessGroup')?['id']), body('Get_locked_item')?['PayloadJson'], string(setProperty(setProperty(setProperty(outputs('Payload'), 'principalId', variables('varAccessGroup')?['id']), 'principalDisplayName', variables('varAccessGroup')?['displayName']), 'requesterIsMember', variables('varAccessMember'))))",
          "runAfter": {
            "Access_for_a_group": [
              "Succeeded"
            ]
          }
        },
        "Get_manager": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365users",
              "connectionName": "shared_office365users",
              "operationId": "Manager_V2"
            },
            "parameters": {
              "id": "@last(split(triggerOutputs()?['body/Author/Claims'], '|'))"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Approved_payload": [
              "Succeeded"
            ]
          }
        },
        "Manager_email": {
          "type": "Compose",
          "inputs": "@if(equals(actions('Get_manager')?['status'], 'Succeeded'), coalesce(body('Get_manager')?['mail'], body('Get_manager')?['userPrincipalName']), body('Get_settings')?['FallbackApproverEmail'])",
          "runAfter": {
            "Get_manager": [
              "Succeeded",
              "Failed"
            ]
          }
        },
        "Manager_name": {
          "type": "Compose",
          "inputs": "@if(equals(actions('Get_manager')?['status'], 'Succeeded'), body('Get_manager')?['displayName'], 'Fallback approver')",
          "runAfter": {
            "Manager_email": [
              "Succeeded"
            ]
          }
        },
        "Select_roles_text": {
          "type": "Select",
          "inputs": {
            "from": "@coalesce(outputs('Payload')?['appRoles'], json('[]'))",
            "select": "@concat('- App role ', item()?['value'], ' (', string(length(coalesce(item()?['assignGroups'], json('[]')))), ' group(s))')"
          },
          "runAfter": {
            "Manager_name": [
              "Succeeded"
            ]
          }
        },
        "Summary_core": {
          "type": "Compose",
          "inputs": "@concat('**', triggerOutputs()?['body/RequestType/Value'], '** – ', triggerOutputs()?['body/TargetDisplayName'], decodeUriComponent('%0A%0A'), 'Request: ', triggerOutputs()?['body/Title'], ' · appCatID: ', triggerOutputs()?['body/AppCatId'], decodeUriComponent('%0A%0A'), 'Requested by: ', triggerOutputs()?['body/Author/DisplayName'], ' (', triggerOutputs()?['body/Author/Email'], ')', decodeUriComponent('%0A%0A'), if(empty(outputs('Payload')?['owningGroup']), '', concat('Owning team: ', outputs('Payload')?['owningGroup']?['displayName'], if(equals(outputs('Payload')?['owningGroup']?['mode'], 'new'), ' (new group)', ''), decodeUriComponent('%0A%0A'))), if(equals(outputs('Payload')?['exposeApi']?['enabled'], true), concat('Expose API: ', outputs('Payload')?['exposeApi']?['identifierUriTemplate'], ', ', string(length(coalesce(outputs('Payload')?['exposeApi']?['scopes'], json('[]')))), ' scope(s)', decodeUriComponent('%0A%0A')), ''), if(empty(body('Select_roles_text')), '', concat(join(body('Select_roles_text'), decodeUriComponent('%0A')), decodeUriComponent('%0A%0A'))), if(empty(outputs('Payload')?['graphDelegatedScopes']), '', concat('API permissions (Microsoft Graph, delegated): ', replace(outputs('Payload')?['graphDelegatedScopes'], ',', ', '), decodeUriComponent('%0A%0A'))), if(empty(outputs('Payload')?['ownerRole']), '', concat('Owner gets role: ', outputs('Payload')?['ownerRole'], decodeUriComponent('%0A%0A'))), if(equals(triggerOutputs()?['body/RequestType/Value'], 'grantAccess'), concat('Access for: ', if(equals(outputs('Payload')?['principalType'], 'group'), concat('group ', coalesce(variables('varAccessGroup')?['displayName'], outputs('Payload')?['groupQuery'])), 'the requester'), ', role ', coalesce(outputs('Payload')?['roleValue'], 'Default Access'), decodeUriComponent('%0A%0A')), ''), if(equals(triggerOutputs()?['body/RequestType/Value'], 'deleteAppRegistration'), concat('**DELETE: ', coalesce(outputs('Payload')?['actionLabel'], outputs('Payload')?['action']), '**', decodeUriComponent('%0A%0A')), ''), 'Justification: ', triggerOutputs()?['body/Justification'])",
          "runAfter": {
            "Select_roles_text": [
              "Succeeded"
            ]
          }
        },
        "Highlights": {
          "type": "Compose",
          "inputs": "@concat(if(empty(outputs('Payload')?['graphAdditionalScopes']), '', concat('🔴 **Additional delegated permissions to review: ', replace(outputs('Payload')?['graphAdditionalScopes'], ',', ', '), '**', decodeUriComponent('%0A%0A'))), if(empty(variables('varAccessGroup')?['id']), '', if(equals(variables('varAccessMember'), 'yes'), concat('🟢 **Group ', variables('varAccessGroup')?['displayName'], ':** the requester is a member', decodeUriComponent('%0A%0A')), concat('🔴 **Group ', variables('varAccessGroup')?['displayName'], ': the requester is NOT a member of this group**', decodeUriComponent('%0A%0A')))))",
          "runAfter": {
            "Summary_core": [
              "Succeeded"
            ]
          }
        },
        "Summary": {
          "type": "Compose",
          "inputs": "@concat(outputs('Highlights'), outputs('Summary_core'))",
          "runAfter": {
            "Highlights": [
              "Succeeded"
            ]
          }
        },
        "Highlights_html": {
          "type": "Compose",
          "inputs": "@concat(if(empty(outputs('Payload')?['graphAdditionalScopes']), '', concat('<p style=\"color:#a4262c\"><b>Additional delegated permissions to review:</b> ', replace(outputs('Payload')?['graphAdditionalScopes'], ',', ', '), '</p>')), if(empty(variables('varAccessGroup')?['id']), '', if(equals(variables('varAccessMember'), 'yes'), concat('<p>Group: <b style=\"color:#107c10\">', variables('varAccessGroup')?['displayName'], '</b> (the requester is a member)</p>'), concat('<p>Group: <b style=\"color:#a4262c\">', variables('varAccessGroup')?['displayName'], '</b><br><span style=\"color:#a4262c\"><b>Note: the requester is not a member of this group.</b></span></p>'))))",
          "runAfter": {
            "Summary": [
              "Succeeded"
            ]
          }
        },
        "Heads_up_body": {
          "type": "Compose",
          "inputs": "@concat('<p>Entra request <b>', triggerOutputs()?['body/Title'], '</b> (', triggerOutputs()?['body/RequestType/Value'], ' – ', triggerOutputs()?['body/TargetDisplayName'], ') needs your approval. Please look at these points first:</p>', outputs('Highlights_html'), '<hr>', replace(replace(outputs('Summary_core'), '**', ''), decodeUriComponent('%0A'), '<br>'), '<p>The approval request itself arrives separately in Outlook / Teams.</p><p><a href=\"', body('Get_settings')?['PowerAppUrl'], '\">Open Entra Self-Service</a></p>')",
          "runAfter": {
            "Highlights_html": [
              "Succeeded"
            ]
          }
        },
        "Update_pending_manager": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "PatchItem"
            },
            "parameters": {
              "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
              "table": "EntraRequests",
              "id": "@int(triggerOutputs()?['body/ID'])",
              "item/Title": "@triggerOutputs()?['body/Title']",
              "item/Status/Value": "PendingManagerApproval",
              "item/ManagerEmail": "@outputs('Manager_email')",
              "item/ManagerName": "@outputs('Manager_name')",
              "item/ApprovedPayloadJson": "@outputs('Approved_payload')",
              "item/RequestSummary": "@outputs('Summary')"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Heads_up_body": [
              "Succeeded"
            ]
          }
        },
        "Manager_heads_up": {
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@empty(outputs('Highlights_html'))",
                  false
                ]
              }
            ]
          },
          "actions": {
            "Mail_manager_heads_up": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2"
                },
                "parameters": {
                  "emailMessage/To": "@outputs('Manager_email')",
                  "emailMessage/Subject": "@concat('Please review before approving: Entra request ', triggerOutputs()?['body/Title'])",
                  "emailMessage/Body": "@outputs('Heads_up_body')",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Update_pending_manager": [
              "Succeeded"
            ]
          }
        },
        "Manager_approval": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals",
              "connectionName": "shared_approvals",
              "operationId": "StartAndWaitForAnApproval"
            },
            "parameters": {
              "approvalType": "Basic",
              "WebhookApprovalCreationInput/title": "@concat('Entra request ', triggerOutputs()?['body/Title'], ': ', triggerOutputs()?['body/RequestType/Value'], ' – ', triggerOutputs()?['body/TargetDisplayName'])",
              "WebhookApprovalCreationInput/assignedTo": "@outputs('Manager_email')",
              "WebhookApprovalCreationInput/details": "@outputs('Summary')",
              "WebhookApprovalCreationInput/itemLink": "@{body('Get_settings')?['PowerAppUrl']}",
              "WebhookApprovalCreationInput/itemLinkDescription": "Open Entra Self-Service",
              "WebhookApprovalCreationInput/requestor": "@triggerOutputs()?['body/Author/Email']",
              "WebhookApprovalCreationInput/enableNotifications": true,
              "WebhookApprovalCreationInput/enableReassignment": true
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Manager_heads_up": [
              "Succeeded"
            ]
          }
        },
        "Manager_outcome": {
          "type": "Compose",
          "inputs": "@if(equals(toLower(coalesce(first(body('Manager_approval')?['responses'])?['responder']?['email'], '')), toLower(triggerOutputs()?['body/Author/Email'])), 'Reject', body('Manager_approval')?['outcome'])",
          "runAfter": {
            "Manager_approval": [
              "Succeeded"
            ]
          }
        },
        "Update_manager_decision": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "PatchItem"
            },
            "parameters": {
              "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
              "table": "EntraRequests",
              "id": "@int(triggerOutputs()?['body/ID'])",
              "item/Title": "@triggerOutputs()?['body/Title']",
              "item/ManagerDecision/Value": "@if(equals(outputs('Manager_outcome'), 'Approve'), 'Approved', 'Rejected')",
              "item/ManagerDecisionBy": "@first(body('Manager_approval')?['responses'])?['responder']?['email']",
              "item/ManagerDecisionAt": "@utcNow()",
              "item/ManagerComment": "@first(body('Manager_approval')?['responses'])?['comments']",
              "item/Status/Value": "@if(equals(outputs('Manager_outcome'), 'Approve'), 'PendingEntraApproval', 'Rejected')"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Manager_outcome": [
              "Succeeded"
            ]
          }
        },
        "Manager_approved": {
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@outputs('Manager_outcome')",
                  "Approve"
                ]
              }
            ]
          },
          "actions": {
            "Entra_heads_up": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@empty(outputs('Highlights_html'))",
                      false
                    ]
                  }
                ]
              },
              "actions": {
                "Mail_entra_heads_up": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                      "connectionName": "shared_office365",
                      "operationId": "SendEmailV2"
                    },
                    "parameters": {
                      "emailMessage/To": "@replace(replace(body('Get_settings')?['EntraApproverEmails'], decodeUriComponent('%0D'), ''), decodeUriComponent('%0A'), ';')",
                      "emailMessage/Subject": "@concat('Please review before approving: Entra request ', triggerOutputs()?['body/Title'])",
                      "emailMessage/Body": "@outputs('Heads_up_body')",
                      "emailMessage/Importance": "Normal"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {}
            },
            "Entra_approval": {
              "type": "OpenApiConnectionWebhook",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals",
                  "connectionName": "shared_approvals",
                  "operationId": "StartAndWaitForAnApproval"
                },
                "parameters": {
                  "approvalType": "Basic",
                  "WebhookApprovalCreationInput/title": "@concat('Entra team approval – ', triggerOutputs()?['body/Title'], ': ', triggerOutputs()?['body/TargetDisplayName'])",
                  "WebhookApprovalCreationInput/assignedTo": "@replace(replace(body('Get_settings')?['EntraApproverEmails'], decodeUriComponent('%0D'), ''), decodeUriComponent('%0A'), ';')",
                  "WebhookApprovalCreationInput/details": "@concat(outputs('Summary'), decodeUriComponent('%0A%0A'), 'Manager approval: ', coalesce(first(body('Manager_approval')?['responses'])?['responder']?['displayName'], ''))",
                  "WebhookApprovalCreationInput/itemLink": "@{body('Get_settings')?['PowerAppUrl']}",
                  "WebhookApprovalCreationInput/itemLinkDescription": "Open Entra Self-Service",
                  "WebhookApprovalCreationInput/requestor": "@triggerOutputs()?['body/Author/Email']",
                  "WebhookApprovalCreationInput/enableNotifications": true,
                  "WebhookApprovalCreationInput/enableReassignment": true
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Entra_heads_up": [
                  "Succeeded"
                ]
              }
            },
            "Entra_outcome": {
              "type": "Compose",
              "inputs": "@if(equals(toLower(coalesce(first(body('Entra_approval')?['responses'])?['responder']?['email'], '')), toLower(triggerOutputs()?['body/Author/Email'])), 'Reject', body('Entra_approval')?['outcome'])",
              "runAfter": {
                "Entra_approval": [
                  "Succeeded"
                ]
              }
            },
            "Update_entra_decision": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem"
                },
                "parameters": {
                  "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
                  "table": "EntraRequests",
                  "id": "@int(triggerOutputs()?['body/ID'])",
                  "item/Title": "@triggerOutputs()?['body/Title']",
                  "item/EntraDecision/Value": "@if(equals(outputs('Entra_outcome'), 'Approve'), 'Approved', 'Rejected')",
                  "item/EntraDecisionBy": "@first(body('Entra_approval')?['responses'])?['responder']?['email']",
                  "item/EntraDecisionAt": "@utcNow()",
                  "item/EntraComment": "@first(body('Entra_approval')?['responses'])?['comments']",
                  "item/Status/Value": "@if(equals(outputs('Entra_outcome'), 'Approve'), 'Approved', 'Rejected')"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Entra_outcome": [
                  "Succeeded"
                ]
              }
            },
            "Mail_requester": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2"
                },
                "parameters": {
                  "emailMessage/To": "@triggerOutputs()?['body/Author/Email']",
                  "emailMessage/Subject": "@if(equals(outputs('Entra_outcome'), 'Approve'), concat('Your Entra request ', triggerOutputs()?['body/Title'], ' is approved and being applied'), concat('Your Entra request ', triggerOutputs()?['body/Title'], ' was rejected by the Entra ID team'))",
                  "emailMessage/Body": "@if(equals(outputs('Entra_outcome'), 'Approve'), concat('Your request <b>', triggerOutputs()?['body/Title'], '</b> (', triggerOutputs()?['body/TargetDisplayName'], ') was approved by your manager and the Entra ID team. It is being applied now; you will get another email when it is complete.<br><br><a href=\"', body('Get_settings')?['PowerAppUrl'], '\">Open Entra Self-Service</a>'), concat('Your request <b>', triggerOutputs()?['body/Title'], '</b> (', triggerOutputs()?['body/TargetDisplayName'], ') was rejected by the Entra ID team.<br>Rejected by: ', coalesce(first(body('Entra_approval')?['responses'])?['responder']?['displayName'], ''), '<br>Comment: ', coalesce(first(body('Entra_approval')?['responses'])?['comments'], '(none)'), '<br><br><a href=\"', body('Get_settings')?['PowerAppUrl'], '\">Open Entra Self-Service</a>'))",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Update_entra_decision": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {
              "Mail_manager_rejected": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                    "connectionName": "shared_office365",
                    "operationId": "SendEmailV2"
                  },
                  "parameters": {
                    "emailMessage/To": "@triggerOutputs()?['body/Author/Email']",
                    "emailMessage/Subject": "@concat('Your Entra request ', triggerOutputs()?['body/Title'], ' was rejected by your manager')",
                    "emailMessage/Body": "@concat('Your request <b>', triggerOutputs()?['body/Title'], '</b> (', triggerOutputs()?['body/TargetDisplayName'], ') was rejected by your manager.<br>Rejected by: ', coalesce(first(body('Manager_approval')?['responses'])?['responder']?['displayName'], ''), '<br>Comment: ', coalesce(first(body('Manager_approval')?['responses'])?['comments'], '(none)'), if(equals(body('Manager_approval')?['outcome'], 'Approve'), '<br><br>Note: a request cannot be approved by the person who raised it.', ''), '<br><br><a href=\"', body('Get_settings')?['PowerAppUrl'], '\">Open Entra Self-Service</a>')",
                    "emailMessage/Importance": "Normal"
                  },
                  "authentication": "@parameters('$authentication')"
                },
                "runAfter": {}
              }
            }
          },
          "runAfter": {
            "Update_manager_decision": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}