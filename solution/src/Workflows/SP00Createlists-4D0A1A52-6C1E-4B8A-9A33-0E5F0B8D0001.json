{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "esp_sharedsharepointonline_entra"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "SharePoint site URL (esp_SiteUrl)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "esp_SiteUrl",
            "description": "SharePoint site that holds the Entra self-service lists"
          }
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {},
              "required": []
            }
          }
        }
      },
      "actions": {
        "Schema": {
          "type": "Compose",
          "inputs": {
            "_readme": "Paste this whole file into the 'Schema' Compose action of the SP-00 Create lists flow (docs/02-SHAREPOINT.md, section 2.2b). Field definitions are SharePoint field XML; Name is the internal name the app and flows use.",
            "lists": [
              {
                "title": "EntraRequests",
                "description": "Entra self-service requests. Requester = Created By. Status/decisions/results are written only by the flows.",
                "titleDisplayName": "RequestId",
                "titleIndexed": "true",
                "fields": [
                  "<Field Type='Choice' Name='RequestType' StaticName='RequestType' DisplayName='RequestType' Indexed='TRUE' Format='Dropdown' FillInChoice='FALSE'><CHOICES><CHOICE>createAppRegistration</CHOICE><CHOICE>exposeApi</CHOICE><CHOICE>addAppRoles</CHOICE><CHOICE>assignGroupsToAppRoles</CHOICE><CHOICE>createServicePrincipal</CHOICE><CHOICE>createGroup</CHOICE><CHOICE>onboardGroup</CHOICE></CHOICES></Field>",
                  "<Field Type='Choice' Name='Status' StaticName='Status' DisplayName='Status' Indexed='TRUE' Format='Dropdown' FillInChoice='FALSE'><Default>Submitted</Default><CHOICES><CHOICE>Submitted</CHOICE><CHOICE>PendingManagerApproval</CHOICE><CHOICE>PendingEntraApproval</CHOICE><CHOICE>Approved</CHOICE><CHOICE>InProgress</CHOICE><CHOICE>Completed</CHOICE><CHOICE>Failed</CHOICE><CHOICE>Rejected</CHOICE></CHOICES></Field>",
                  "<Field Type='Text' Name='AppCatId' StaticName='AppCatId' DisplayName='AppCatId' Indexed='TRUE' />",
                  "<Field Type='Text' Name='TargetDisplayName' StaticName='TargetDisplayName' DisplayName='TargetDisplayName' />",
                  "<Field Type='Text' Name='TargetObjectId' StaticName='TargetObjectId' DisplayName='TargetObjectId' />",
                  "<Field Type='Note' Name='Justification' StaticName='Justification' DisplayName='Justification' NumLines='6' RichText='FALSE' RichTextMode='Compatible' AppendOnly='FALSE' />",
                  "<Field Type='Text' Name='TicketReference' StaticName='TicketReference' DisplayName='TicketReference' />",
                  "<Field Type='Note' Name='PayloadJson' StaticName='PayloadJson' DisplayName='PayloadJson' NumLines='6' RichText='FALSE' RichTextMode='Compatible' AppendOnly='FALSE' />",
                  "<Field Type='Note' Name='ApprovedPayloadJson' StaticName='ApprovedPayloadJson' DisplayName='ApprovedPayloadJson' NumLines='6' RichText='FALSE' RichTextMode='Compatible' AppendOnly='FALSE' />",
                  "<Field Type='Note' Name='RequestSummary' StaticName='RequestSummary' DisplayName='RequestSummary' NumLines='6' RichText='FALSE' RichTextMode='Compatible' AppendOnly='FALSE' />",
                  "<Field Type='Text' Name='ManagerEmail' StaticName='ManagerEmail' DisplayName='ManagerEmail' />",
                  "<Field Type='Text' Name='ManagerName' StaticName='ManagerName' DisplayName='ManagerName' />",
                  "<Field Type='Choice' Name='ManagerDecision' StaticName='ManagerDecision' DisplayName='ManagerDecision' Format='Dropdown' FillInChoice='FALSE'><Default>Pending</Default><CHOICES><CHOICE>Pending</CHOICE><CHOICE>Approved</CHOICE><CHOICE>Rejected</CHOICE></CHOICES></Field>",
                  "<Field Type='Text' Name='ManagerDecisionBy' StaticName='ManagerDecisionBy' DisplayName='ManagerDecisionBy' />",
                  "<Field Type='DateTime' Name='ManagerDecisionAt' StaticName='ManagerDecisionAt' DisplayName='ManagerDecisionAt' Format='DateTime' />",
                  "<Field Type='Note' Name='ManagerComment' StaticName='ManagerComment' DisplayName='ManagerComment' NumLines='6' RichText='FALSE' RichTextMode='Compatible' AppendOnly='FALSE' />",
                  "<Field Type='Choice' Name='EntraDecision' StaticName='EntraDecision' DisplayName='EntraDecision' Format='Dropdown' FillInChoice='FALSE'><Default>Pending</Default><CHOICES><CHOICE>Pending</CHOICE><CHOICE>Approved</CHOICE><CHOICE>Rejected</CHOICE></CHOICES></Field>",
                  "<Field Type='Text' Name='EntraDecisionBy' StaticName='EntraDecisionBy' DisplayName='EntraDecisionBy' />",
                  "<Field Type='DateTime' Name='EntraDecisionAt' StaticName='EntraDecisionAt' DisplayName='EntraDecisionAt' Format='DateTime' />",
                  "<Field Type='Note' Name='EntraComment' StaticName='EntraComment' DisplayName='EntraComment' NumLines='6' RichText='FALSE' RichTextMode='Compatible' AppendOnly='FALSE' />",
                  "<Field Type='Note' Name='ResultJson' StaticName='ResultJson' DisplayName='ResultJson' NumLines='6' RichText='FALSE' RichTextMode='Compatible' AppendOnly='FALSE' />",
                  "<Field Type='Note' Name='ErrorMessage' StaticName='ErrorMessage' DisplayName='ErrorMessage' NumLines='6' RichText='FALSE' RichTextMode='Compatible' AppendOnly='FALSE' />",
                  "<Field Type='DateTime' Name='CompletedAt' StaticName='CompletedAt' DisplayName='CompletedAt' Format='DateTime' />"
                ]
              },
              {
                "title": "EntraCatalogApps",
                "description": "App registrations managed by the platform. Written only by flows ER-02 (execute) and ER-03 (sync).",
                "titleDisplayName": "DisplayName",
                "titleIndexed": "false",
                "fields": [
                  "<Field Type='Text' Name='ObjectId' StaticName='ObjectId' DisplayName='ObjectId' Indexed='TRUE' />",
                  "<Field Type='Text' Name='AppId' StaticName='AppId' DisplayName='AppId' Indexed='TRUE' />",
                  "<Field Type='Text' Name='AppCatId' StaticName='AppCatId' DisplayName='AppCatId' Indexed='TRUE' />",
                  "<Field Type='Text' Name='TeamGroupId' StaticName='TeamGroupId' DisplayName='TeamGroupId' />",
                  "<Field Type='Text' Name='TeamGroupName' StaticName='TeamGroupName' DisplayName='TeamGroupName' />",
                  "<Field Type='Text' Name='ServicePrincipalId' StaticName='ServicePrincipalId' DisplayName='ServicePrincipalId' />",
                  "<Field Type='Text' Name='IdentifierUri' StaticName='IdentifierUri' DisplayName='IdentifierUri' />",
                  "<Field Type='Note' Name='AppRolesJson' StaticName='AppRolesJson' DisplayName='AppRolesJson' NumLines='6' RichText='FALSE' RichTextMode='Compatible' AppendOnly='FALSE' />",
                  "<Field Type='Note' Name='ScopesJson' StaticName='ScopesJson' DisplayName='ScopesJson' NumLines='6' RichText='FALSE' RichTextMode='Compatible' AppendOnly='FALSE' />",
                  "<Field Type='Note' Name='TeamMemberUpns' StaticName='TeamMemberUpns' DisplayName='TeamMemberUpns' NumLines='6' RichText='FALSE' RichTextMode='Compatible' AppendOnly='FALSE' />",
                  "<Field Type='Note' Name='OwnerUpns' StaticName='OwnerUpns' DisplayName='OwnerUpns' NumLines='6' RichText='FALSE' RichTextMode='Compatible' AppendOnly='FALSE' />",
                  "<Field Type='DateTime' Name='LastSynced' StaticName='LastSynced' DisplayName='LastSynced' Format='DateTime' />"
                ]
              },
              {
                "title": "EntraCatalogGroups",
                "description": "Security groups users may pick for owning teams and role assignments. Add a row with just Title and GroupId to onboard an existing group; ER-03 fills the rest.",
                "titleDisplayName": "DisplayName",
                "titleIndexed": "false",
                "fields": [
                  "<Field Type='Text' Name='GroupId' StaticName='GroupId' DisplayName='GroupId' Indexed='TRUE' />",
                  "<Field Type='Text' Name='AppCatId' StaticName='AppCatId' DisplayName='AppCatId' />",
                  "<Field Type='Note' Name='Description' StaticName='Description' DisplayName='Description' NumLines='6' RichText='FALSE' RichTextMode='Compatible' AppendOnly='FALSE' />",
                  "<Field Type='Note' Name='OwnerUpns' StaticName='OwnerUpns' DisplayName='OwnerUpns' NumLines='6' RichText='FALSE' RichTextMode='Compatible' AppendOnly='FALSE' />",
                  "<Field Type='Note' Name='MemberUpns' StaticName='MemberUpns' DisplayName='MemberUpns' NumLines='6' RichText='FALSE' RichTextMode='Compatible' AppendOnly='FALSE' />",
                  "<Field Type='DateTime' Name='LastSynced' StaticName='LastSynced' DisplayName='LastSynced' Format='DateTime' />"
                ]
              },
              {
                "title": "EntraSettings",
                "description": "Configuration for the flows. Keep exactly ONE item (ID 1).",
                "titleDisplayName": "Title",
                "titleIndexed": "false",
                "fields": [
                  "<Field Type='Text' Name='TenantId' StaticName='TenantId' DisplayName='TenantId' />",
                  "<Field Type='Text' Name='GraphClientId' StaticName='GraphClientId' DisplayName='GraphClientId' />",
                  "<Field Type='Text' Name='ManagedByTag' StaticName='ManagedByTag' DisplayName='ManagedByTag' />",
                  "<Field Type='Text' Name='ServiceAccountUpn' StaticName='ServiceAccountUpn' DisplayName='ServiceAccountUpn' />",
                  "<Field Type='Text' Name='FallbackApproverEmail' StaticName='FallbackApproverEmail' DisplayName='FallbackApproverEmail' />",
                  "<Field Type='Text' Name='KeyVaultName' StaticName='KeyVaultName' DisplayName='KeyVaultName' />",
                  "<Field Type='Text' Name='PfxSecretName' StaticName='PfxSecretName' DisplayName='PfxSecretName' />",
                  "<Field Type='Text' Name='PfxPasswordSecretName' StaticName='PfxPasswordSecretName' DisplayName='PfxPasswordSecretName' />",
                  "<Field Type='Text' Name='PowerAppUrl' StaticName='PowerAppUrl' DisplayName='PowerAppUrl' />",
                  "<Field Type='Note' Name='EntraApproverEmails' StaticName='EntraApproverEmails' DisplayName='EntraApproverEmails' NumLines='6' RichText='FALSE' RichTextMode='Compatible' AppendOnly='FALSE' />"
                ]
              }
            ]
          },
          "runAfter": {}
        },
        "Apply_to_each_list": {
          "type": "Foreach",
          "foreach": "@outputs('Schema')?['lists']",
          "actions": {
            "Get_list": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest"
                },
                "parameters": {
                  "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists/getbytitle('@{items('Apply_to_each_list')?['title']}')?$select=Id",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "List_missing?": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@outputs('Get_list')?['statusCode']",
                      404
                    ]
                  }
                ]
              },
              "actions": {
                "Create_list": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest"
                    },
                    "parameters": {
                      "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
                      "parameters/method": "POST",
                      "parameters/uri": "_api/web/lists",
                      "parameters/headers": {
                        "Accept": "application/json;odata=verbose",
                        "Content-Type": "application/json;odata=verbose"
                      },
                      "parameters/body": "{\"__metadata\":{\"type\":\"SP.List\"},\"BaseTemplate\":100,\"Title\":\"@{items('Apply_to_each_list')?['title']}\",\"Description\":\"@{items('Apply_to_each_list')?['description']}\",\"EnableVersioning\":true}"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                },
                "Set_version_limit": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest"
                    },
                    "parameters": {
                      "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
                      "parameters/method": "POST",
                      "parameters/uri": "_api/web/lists/getbytitle('@{items('Apply_to_each_list')?['title']}')",
                      "parameters/headers": {
                        "Accept": "application/json;odata=verbose",
                        "Content-Type": "application/json;odata=verbose",
                        "IF-MATCH": "*",
                        "X-HTTP-Method": "MERGE"
                      },
                      "parameters/body": "{\"__metadata\":{\"type\":\"SP.List\"},\"MajorVersionLimit\":500}"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "Create_list": [
                      "Succeeded"
                    ]
                  }
                },
                "Rename_Title": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest"
                    },
                    "parameters": {
                      "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
                      "parameters/method": "POST",
                      "parameters/uri": "_api/web/lists/getbytitle('@{items('Apply_to_each_list')?['title']}')/fields/getbyinternalnameortitle('Title')",
                      "parameters/headers": {
                        "Accept": "application/json;odata=verbose",
                        "Content-Type": "application/json;odata=verbose",
                        "IF-MATCH": "*",
                        "X-HTTP-Method": "MERGE"
                      },
                      "parameters/body": "{\"__metadata\":{\"type\":\"SP.Field\"},\"Title\":\"@{items('Apply_to_each_list')?['titleDisplayName']}\",\"Indexed\":@{items('Apply_to_each_list')?['titleIndexed']}}"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "Set_version_limit": [
                      "Succeeded"
                    ]
                  }
                },
                "Apply_to_each_field": {
                  "type": "Foreach",
                  "foreach": "@items('Apply_to_each_list')?['fields']",
                  "actions": {
                    "Add_field": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                          "connectionName": "shared_sharepointonline",
                          "operationId": "HttpRequest"
                        },
                        "parameters": {
                          "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
                          "parameters/method": "POST",
                          "parameters/uri": "_api/web/lists/getbytitle('@{items('Apply_to_each_list')?['title']}')/fields/createfieldasxml",
                          "parameters/headers": {
                            "Accept": "application/json;odata=verbose",
                            "Content-Type": "application/json;odata=verbose"
                          },
                          "parameters/body": "{\"parameters\":{\"__metadata\":{\"type\":\"SP.XmlSchemaFieldCreationInformation\"},\"SchemaXml\":\"@{items('Apply_to_each_field')}\",\"Options\":24}}"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runAfter": {}
                    }
                  },
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 1
                    }
                  },
                  "runAfter": {
                    "Rename_Title": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Get_list": [
                  "Succeeded",
                  "Failed"
                ]
              }
            }
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "runAfter": {
            "Schema": [
              "Succeeded"
            ]
          }
        },
        "Get_settings_item": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            },
            "parameters": {
              "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
              "parameters/method": "GET",
              "parameters/uri": "_api/web/lists/getbytitle('EntraSettings')/items?$top=1&$select=Id",
              "parameters/headers": {
                "Accept": "application/json;odata=nometadata"
              }
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Apply_to_each_list": [
              "Succeeded"
            ]
          }
        },
        "No_settings_item?": {
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@empty(body('Get_settings_item')?['value'])",
                  true
                ]
              }
            ]
          },
          "actions": {
            "Create_settings_item": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest"
                },
                "parameters": {
                  "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
                  "parameters/method": "POST",
                  "parameters/uri": "_api/web/lists/getbytitle('EntraSettings')/items",
                  "parameters/headers": {
                    "Accept": "application/json;odata=verbose",
                    "Content-Type": "application/json;odata=verbose"
                  },
                  "parameters/body": "{\"__metadata\":{\"type\":\"SP.Data.EntraSettingsListItem\"},\"Title\":\"settings\",\"ManagedByTag\":\"entra-pp\",\"PfxSecretName\":\"entra-pp-graph-pfx\",\"PfxPasswordSecretName\":\"entra-pp-graph-pfx-password\"}"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Get_settings_item": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}