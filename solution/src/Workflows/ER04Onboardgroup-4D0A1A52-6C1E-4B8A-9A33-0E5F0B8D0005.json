{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "esp_sharedsharepointonline_entra"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_webcontents": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "esp_sharedwebcontents_entra"
        },
        "api": {
          "name": "shared_webcontents"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "SharePoint site URL (esp_SiteUrl)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "esp_SiteUrl",
            "description": "SharePoint site that holds the Entra self-service lists"
          }
        }
      },
      "triggers": {
        "When_an_item_is_created": {
          "type": "OpenApiConnection",
          "recurrence": {
            "interval": 1,
            "frequency": "Minute"
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnNewItems"
            },
            "parameters": {
              "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
              "table": "EntraRequests"
            },
            "authentication": "@parameters('$authentication')"
          },
          "conditions": [
            {
              "expression": "@and(equals(triggerBody()?['Status']?['Value'], 'Submitted'), equals(triggerBody()?['RequestType']?['Value'], 'onboardGroup'))"
            }
          ]
        }
      },
      "actions": {
        "Get_settings": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItem"
            },
            "parameters": {
              "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
              "table": "EntraSettings",
              "id": 1
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {}
        },
        "Mark_in_progress": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "PatchItem"
            },
            "parameters": {
              "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
              "table": "EntraRequests",
              "id": "@int(triggerOutputs()?['body/ID'])",
              "item/Title": "@triggerOutputs()?['body/Title']",
              "item/Status/Value": "InProgress"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Get_settings": [
              "Succeeded"
            ]
          }
        },
        "Requester": {
          "type": "Compose",
          "inputs": "@toLower(last(split(triggerOutputs()?['body/Author/Claims'], '|')))",
          "runAfter": {
            "Mark_in_progress": [
              "Succeeded"
            ]
          }
        },
        "Group_query": {
          "type": "Compose",
          "inputs": "@trim(coalesce(triggerOutputs()?['body/TargetDisplayName'], triggerOutputs()?['body/TargetObjectId'], ''))",
          "runAfter": {
            "Requester": [
              "Succeeded"
            ]
          }
        },
        "Init_varGroup": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "varGroup",
                "type": "object",
                "value": {}
              }
            ]
          },
          "runAfter": {
            "Group_query": [
              "Succeeded"
            ]
          }
        },
        "Try": {
          "type": "Scope",
          "actions": {
            "HTTP_Get_requester": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents",
                  "connectionName": "shared_webcontents",
                  "operationId": "InvokeHttp"
                },
                "parameters": {
                  "request/method": "GET",
                  "request/url": "https://graph.microsoft.com/v1.0/users/@{outputs('Requester')}?$select=id"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Query_is_object_id": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@and(equals(length(outputs('Group_query')), 36), equals(length(split(outputs('Group_query'), '-')), 5))",
                      true
                    ]
                  }
                ]
              },
              "actions": {
                "HTTP_Get_group_by_id": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents",
                      "connectionName": "shared_webcontents",
                      "operationId": "InvokeHttp"
                    },
                    "parameters": {
                      "request/method": "GET",
                      "request/url": "https://graph.microsoft.com/v1.0/groups/@{toLower(outputs('Group_query'))}?$select=id,displayName,description,securityEnabled"
                    },
                    "authentication": "@parameters('$authentication')",
                    "retryPolicy": {
                      "type": "none"
                    }
                  },
                  "runAfter": {}
                },
                "Found_by_id": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@outputs('HTTP_Get_group_by_id')?['statusCode']",
                          200
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Set_group_from_id": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "varGroup",
                        "value": "@body('HTTP_Get_group_by_id')"
                      },
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {
                      "Fail_id_not_found": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                            "connectionName": "shared_sharepointonline",
                            "operationId": "PatchItem"
                          },
                          "parameters": {
                            "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
                            "table": "EntraRequests",
                            "id": "@int(triggerOutputs()?['body/ID'])",
                            "item/Title": "@triggerOutputs()?['body/Title']",
                            "item/Status/Value": "Failed",
                            "item/ErrorMessage": "@concat('No group with Object ID ', outputs('Group_query'), ' was found. Check the ID (Entra admin center > Groups > the group > Object ID).')"
                          },
                          "authentication": "@parameters('$authentication')"
                        },
                        "runAfter": {}
                      },
                      "Stop_id_not_found": {
                        "type": "Terminate",
                        "inputs": {
                          "runStatus": "Failed",
                          "runError": {
                            "code": "GroupNotFound",
                            "message": "@concat('No group with Object ID ', outputs('Group_query'), ' was found. Check the ID (Entra admin center > Groups > the group > Object ID).')"
                          }
                        },
                        "runAfter": {
                          "Fail_id_not_found": [
                            "Succeeded"
                          ]
                        }
                      }
                    }
                  },
                  "runAfter": {
                    "HTTP_Get_group_by_id": [
                      "Succeeded",
                      "Failed"
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "HTTP_Find_group_by_name": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents",
                        "connectionName": "shared_webcontents",
                        "operationId": "InvokeHttp"
                      },
                      "parameters": {
                        "request/method": "GET",
                        "request/url": "https://graph.microsoft.com/v1.0/groups?$filter=displayName eq '@{encodeUriComponent(replace(outputs('Group_query'), '''', ''''''))}'&$select=id,displayName,description,securityEnabled&$top=5"
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runAfter": {}
                  },
                  "No_group_with_that_name": {
                    "type": "If",
                    "expression": {
                      "and": [
                        {
                          "equals": [
                            "@empty(body('HTTP_Find_group_by_name')?['value'])",
                            true
                          ]
                        }
                      ]
                    },
                    "actions": {
                      "Fail_name_not_found": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                            "connectionName": "shared_sharepointonline",
                            "operationId": "PatchItem"
                          },
                          "parameters": {
                            "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
                            "table": "EntraRequests",
                            "id": "@int(triggerOutputs()?['body/ID'])",
                            "item/Title": "@triggerOutputs()?['body/Title']",
                            "item/Status/Value": "Failed",
                            "item/ErrorMessage": "@concat('No group named ', outputs('Group_query'), ' was found. Check the exact name, or enter the group''s Object ID.')"
                          },
                          "authentication": "@parameters('$authentication')"
                        },
                        "runAfter": {}
                      },
                      "Stop_name_not_found": {
                        "type": "Terminate",
                        "inputs": {
                          "runStatus": "Failed",
                          "runError": {
                            "code": "GroupNotFound",
                            "message": "@concat('No group named ', outputs('Group_query'), ' was found. Check the exact name, or enter the group''s Object ID.')"
                          }
                        },
                        "runAfter": {
                          "Fail_name_not_found": [
                            "Succeeded"
                          ]
                        }
                      }
                    },
                    "else": {
                      "actions": {}
                    },
                    "runAfter": {
                      "HTTP_Find_group_by_name": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Several_groups_with_that_name": {
                    "type": "If",
                    "expression": {
                      "and": [
                        {
                          "greater": [
                            "@length(body('HTTP_Find_group_by_name')?['value'])",
                            1
                          ]
                        }
                      ]
                    },
                    "actions": {
                      "Fail_name_ambiguous": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                            "connectionName": "shared_sharepointonline",
                            "operationId": "PatchItem"
                          },
                          "parameters": {
                            "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
                            "table": "EntraRequests",
                            "id": "@int(triggerOutputs()?['body/ID'])",
                            "item/Title": "@triggerOutputs()?['body/Title']",
                            "item/Status/Value": "Failed",
                            "item/ErrorMessage": "@concat(string(length(body('HTTP_Find_group_by_name')?['value'])), ' groups are named ', outputs('Group_query'), '. Enter the Object ID of the one you mean.')"
                          },
                          "authentication": "@parameters('$authentication')"
                        },
                        "runAfter": {}
                      },
                      "Stop_name_ambiguous": {
                        "type": "Terminate",
                        "inputs": {
                          "runStatus": "Failed",
                          "runError": {
                            "code": "GroupNameAmbiguous",
                            "message": "@concat(string(length(body('HTTP_Find_group_by_name')?['value'])), ' groups are named ', outputs('Group_query'), '. Enter the Object ID of the one you mean.')"
                          }
                        },
                        "runAfter": {
                          "Fail_name_ambiguous": [
                            "Succeeded"
                          ]
                        }
                      }
                    },
                    "else": {
                      "actions": {}
                    },
                    "runAfter": {
                      "No_group_with_that_name": [
                        "Succeeded"
                      ]
                    }
                  },
                  "Set_group_from_name": {
                    "type": "SetVariable",
                    "inputs": {
                      "name": "varGroup",
                      "value": "@first(body('HTTP_Find_group_by_name')?['value'])"
                    },
                    "runAfter": {
                      "Several_groups_with_that_name": [
                        "Succeeded"
                      ]
                    }
                  }
                }
              },
              "runAfter": {
                "HTTP_Get_requester": [
                  "Succeeded"
                ]
              }
            },
            "Group_id": {
              "type": "Compose",
              "inputs": "@variables('varGroup')?['id']",
              "runAfter": {
                "Query_is_object_id": [
                  "Succeeded"
                ]
              }
            },
            "HTTP_Check_membership": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents",
                  "connectionName": "shared_webcontents",
                  "operationId": "InvokeHttp"
                },
                "parameters": {
                  "request/method": "POST",
                  "request/url": "https://graph.microsoft.com/v1.0/users/@{body('HTTP_Get_requester')?['id']}/checkMemberGroups",
                  "request/headers": {
                    "Content-Type": "application/json"
                  },
                  "request/body": "{\"groupIds\": [\"@{outputs('Group_id')}\"]}"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Group_id": [
                  "Succeeded"
                ]
              }
            },
            "HTTP_Group_owners": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents",
                  "connectionName": "shared_webcontents",
                  "operationId": "InvokeHttp"
                },
                "parameters": {
                  "request/method": "GET",
                  "request/url": "https://graph.microsoft.com/v1.0/groups/@{outputs('Group_id')}/owners/microsoft.graph.user?$select=id,userPrincipalName"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "HTTP_Check_membership": [
                  "Succeeded"
                ]
              }
            },
            "Member_or_owner": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@or(not(empty(body('HTTP_Check_membership')?['value'])), contains(string(body('HTTP_Group_owners')?['value']), body('HTTP_Get_requester')?['id']))",
                      true
                    ]
                  }
                ]
              },
              "actions": {},
              "else": {
                "actions": {
                  "Fail_not_member": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                        "connectionName": "shared_sharepointonline",
                        "operationId": "PatchItem"
                      },
                      "parameters": {
                        "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
                        "table": "EntraRequests",
                        "id": "@int(triggerOutputs()?['body/ID'])",
                        "item/Title": "@triggerOutputs()?['body/Title']",
                        "item/Status/Value": "Failed",
                        "item/ErrorMessage": "@concat('You are neither a member nor an owner of ', variables('varGroup')?['displayName'], '. Ask one of its owners to add you, or pick another group.')"
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runAfter": {}
                  },
                  "Stop_not_member": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Failed",
                      "runError": {
                        "code": "NotMemberOrOwner",
                        "message": "@concat('You are neither a member nor an owner of ', variables('varGroup')?['displayName'], '. Ask one of its owners to add you, or pick another group.')"
                      }
                    },
                    "runAfter": {
                      "Fail_not_member": [
                        "Succeeded"
                      ]
                    }
                  }
                }
              },
              "runAfter": {
                "HTTP_Group_owners": [
                  "Succeeded"
                ]
              }
            },
            "Security_enabled": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@variables('varGroup')?['securityEnabled']",
                      true
                    ]
                  }
                ]
              },
              "actions": {},
              "else": {
                "actions": {
                  "Fail_not_security": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                        "connectionName": "shared_sharepointonline",
                        "operationId": "PatchItem"
                      },
                      "parameters": {
                        "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
                        "table": "EntraRequests",
                        "id": "@int(triggerOutputs()?['body/ID'])",
                        "item/Title": "@triggerOutputs()?['body/Title']",
                        "item/Status/Value": "Failed",
                        "item/ErrorMessage": "@concat(variables('varGroup')?['displayName'], ' is not a security group. Only security-enabled groups can be used for owning teams and app roles.')"
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runAfter": {}
                  },
                  "Stop_not_security": {
                    "type": "Terminate",
                    "inputs": {
                      "runStatus": "Failed",
                      "runError": {
                        "code": "NotSecurityGroup",
                        "message": "@concat(variables('varGroup')?['displayName'], ' is not a security group. Only security-enabled groups can be used for owning teams and app roles.')"
                      }
                    },
                    "runAfter": {
                      "Fail_not_security": [
                        "Succeeded"
                      ]
                    }
                  }
                }
              },
              "runAfter": {
                "Member_or_owner": [
                  "Succeeded"
                ]
              }
            },
            "HTTP_Group_members": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents",
                  "connectionName": "shared_webcontents",
                  "operationId": "InvokeHttp"
                },
                "parameters": {
                  "request/method": "GET",
                  "request/url": "https://graph.microsoft.com/v1.0/groups/@{outputs('Group_id')}/transitiveMembers/microsoft.graph.user?$select=userPrincipalName&$top=999"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Security_enabled": [
                  "Succeeded"
                ]
              }
            },
            "Select_member_upns": {
              "type": "Select",
              "inputs": {
                "from": "@body('HTTP_Group_members')?['value']",
                "select": "@toLower(item()?['userPrincipalName'])"
              },
              "runAfter": {
                "HTTP_Group_members": [
                  "Succeeded"
                ]
              }
            },
            "Select_owner_upns": {
              "type": "Select",
              "inputs": {
                "from": "@body('HTTP_Group_owners')?['value']",
                "select": "@toLower(item()?['userPrincipalName'])"
              },
              "runAfter": {
                "Select_member_upns": [
                  "Succeeded"
                ]
              }
            },
            "Get_catalog_row": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems"
                },
                "parameters": {
                  "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
                  "table": "EntraCatalogGroups",
                  "$filter": "GroupId eq '@{outputs('Group_id')}'",
                  "$top": 1
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Select_owner_upns": [
                  "Succeeded"
                ]
              }
            },
            "Row_missing": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@empty(body('Get_catalog_row')?['value'])",
                      true
                    ]
                  }
                ]
              },
              "actions": {
                "Create_catalog_row": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PostItem"
                    },
                    "parameters": {
                      "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
                      "table": "EntraCatalogGroups",
                      "item/Title": "@variables('varGroup')?['displayName']",
                      "item/GroupId": "@outputs('Group_id')",
                      "item/Description": "@variables('varGroup')?['description']",
                      "item/AppCatId": "@if(contains(coalesce(variables('varGroup')?['description'], ''), '[appCatID='), first(split(last(split(variables('varGroup')?['description'], '[appCatID=')), ';')), '')",
                      "item/MemberUpns": "@concat(';', join(body('Select_member_upns'), ';'), ';')",
                      "item/OwnerUpns": "@concat(';', join(body('Select_owner_upns'), ';'), ';')",
                      "item/LastSynced": "@utcNow()"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {
                  "Update_catalog_row": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                        "connectionName": "shared_sharepointonline",
                        "operationId": "PatchItem"
                      },
                      "parameters": {
                        "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
                        "table": "EntraCatalogGroups",
                        "id": "@first(body('Get_catalog_row')?['value'])?['ID']",
                        "item/Title": "@variables('varGroup')?['displayName']",
                        "item/GroupId": "@outputs('Group_id')",
                        "item/Description": "@variables('varGroup')?['description']",
                        "item/AppCatId": "@if(contains(coalesce(variables('varGroup')?['description'], ''), '[appCatID='), first(split(last(split(variables('varGroup')?['description'], '[appCatID=')), ';')), '')",
                        "item/MemberUpns": "@concat(';', join(body('Select_member_upns'), ';'), ';')",
                        "item/OwnerUpns": "@concat(';', join(body('Select_owner_upns'), ';'), ';')",
                        "item/LastSynced": "@utcNow()"
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runAfter": {}
                  }
                }
              },
              "runAfter": {
                "Get_catalog_row": [
                  "Succeeded"
                ]
              }
            },
            "Mark_completed": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem"
                },
                "parameters": {
                  "dataset": "@parameters('SharePoint site URL (esp_SiteUrl)')",
                  "table": "EntraRequests",
                  "id": "@int(triggerOutputs()?['body/ID'])",
                  "item/Title": "@triggerOutputs()?['body/Title']",
                  "item/Status/Value": "Completed",
                  "item/CompletedAt": "@utcNow()",
                  "item/TargetDisplayName": "@variables('varGroup')?['displayName']",
                  "item/TargetObjectId": "@outputs('Group_id')",
                  "item/ResultJson": "@string(setProperty(setProperty(json('{}'), 'groupId', outputs('Group_id')), 'groupDisplayName', variables('varGroup')?['displayName']))"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Row_missing": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Init_varGroup": [
              "Succeeded"
            ]
          }
        },
        "Catch": {
          "type": "Scope",
          "actions": {
            "Failed_actions": {
              "type": "Query",
              "inputs": {
                "from": "@result('Try')",
                "where": "@equals(item()?['status'], 'Failed')"
              },
              "runAfter": {}
            },
            "Error_text": {
              "type": "Compose",
              "inputs": "@concat(first(body('Failed_actions'))?['name'], ': ', coalesce(first(body('Failed_actions'))?['outputs']?['body']?['error']?['message'], first(body('Failed_actions'))?['error']?['message'], 'see the ER-04 run history'))",
              "runAfter": {
                "Failed_actions": [
                  "Succeeded"
                ]
              }
            },
            "Mark_failed": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
